# Speed Test Configuration

# Test Mode: 'dummy' for fake data (testing UI) or 'real' for actual speed tests
NEXT_PUBLIC_TEST_MODE=real

# Auto Start: 'true' to automatically start test on page load, 'false' for manual start
NEXT_PUBLIC_AUTO_START=false

# Dummy Test Configuration (only used when TEST_MODE=dummy)
NEXT_PUBLIC_DUMMY_DOWNLOAD_SPEED=150.5
NEXT_PUBLIC_DUMMY_UPLOAD_SPEED=75.2
NEXT_PUBLIC_DUMMY_PING=25
